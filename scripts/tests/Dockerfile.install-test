# Fresh Ubuntu with a sudo user, in the state README.md starts from (git + ssh
# installed, no curl). Used by scripts/test_install.sh and scripts/test_wsl.sh
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y sudo git openssh-client ca-certificates locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

# like a desktop: a UTF-8 locale (changes sort order) and running inside VS Code's
# terminal (.zshrc prints a cursor code then)
ENV LANG=en_US.UTF-8 IN_VSCODE=true

# ubuntu images >= 23.04 ship a default "ubuntu" user with uid 1000
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && useradd -m -s /bin/bash tester \
    && echo "tester ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/tester

USER tester
ENV USER=tester HOME=/home/tester
WORKDIR /home/tester
COPY --chown=tester:tester . /home/tester/dotfiles
